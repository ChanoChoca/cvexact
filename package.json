    "@huggingface/transformers": "^4.2.0",
    "ai": "^7.0.58",
    "better-auth": "^1.6.26",
    "dexie": "^4.4.6",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
