    "build": "next build",
    "postbuild": "node scripts/verify-build-legal.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "audit:publication": "node scripts/audit-publication.mjs",
    "verify:publication-source": "node scripts/verify-public-source.mjs --require",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "legal:overdue": "node --env-file=.env scripts/legal-requests-overdue.mjs"
  },
