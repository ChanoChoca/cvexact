    "next": "16.3.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.5",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "playwright-core": "^1.62.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
